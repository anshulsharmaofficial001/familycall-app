<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/incoming_gradient_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📞  Incoming Call"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:alpha="0.85"
        android:letterSpacing="0.08"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/avatarFrame"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.38"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:background="@drawable/circle_white_alpha" />

        <TextView
            android:id="@+id/callerAvatarLetter"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="?"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circle_green_dark" />

    </FrameLayout>

    <TextView
        android:id="@+id/callerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Family Member"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatarFrame" />

    <TextView
        android:id="@+id/callerUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="@color/white"
        android:textSize="15sp"
        android:alpha="0.7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callerName" />

    <!-- Accept + Decline row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="64dp"
        android:paddingHorizontal="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Decline -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/declineBtn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:cornerRadius="36dp"
                app:icon="@drawable/ic_end_call"
                app:iconSize="30dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="@color/red"
                android:elevation="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Decline" android:textColor="@color/white" android:textSize="13sp" android:layout_marginTop="10dp" android:alpha="0.9" android:textStyle="bold" />
        </LinearLayout>

        <!-- Accept -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/acceptBtn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:cornerRadius="36dp"
                app:icon="@drawable/ic_phone"
                app:iconSize="30dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="@color/green"
                android:elevation="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accept" android:textColor="@color/white" android:textSize="13sp" android:layout_marginTop="10dp" android:alpha="0.9" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
