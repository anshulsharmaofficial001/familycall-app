<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FamilyCall" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>

    <style name="Theme.FamilyCall.FullScreen" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/call_screen_bg</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>
</resources>
